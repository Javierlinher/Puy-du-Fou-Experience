<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla: lista de rutas + botón "Crear ruta" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRutas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Crear ruta: manda al mapa y activa modo creación -->
    <Button
        android:id="@+id/btnCrearRuta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crear_ruta" />

    <!-- Mensaje cuando no hay rutas -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/no_tienes_rutas_guardadas"
        android:visibility="gone" />

    <!-- Lista de rutas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRutas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

</LinearLayout>
